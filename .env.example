# Generated by scripts/generate_config.py from source/app/config.py.
# Do not edit by hand; edit config.py and re-run the generator.

# --- Deployment (Docker Compose) ---
# Host port the gateway is published on (compose `ports:` mapping only). The gateway always listens on port 8000 inside the container.
PORT=9317

# Host user ID the container runs as, so the bind-mounted `data/` directory stays writable and owned by you. Defaults to 1000 when unset.
UID=1000

# Host group ID the container runs as, so the bind-mounted `data/` directory stays writable and owned by you. Defaults to 1000 when unset.
GID=1000

# --- Upstream & gateway ---
# Upstream local LLM (OpenAI-compatible API).
LLM_BASE_URL=http://host.docker.internal:14434

# Optional header line sent on every upstream request, e.g. `Authorization: Bearer <token>` (the full line, not just the token). This is a secret: keep it out of version control. Unset or empty sends no header.
LLM_BEARER_HEADER=

# Upstream read/write timeout in seconds once connected — generation can be slow.
REQUEST_TIMEOUT=300

# Upstream connection timeout in seconds; kept short so a dead/blackholed endpoint fails fast.
CONNECT_TIMEOUT=10

# Directory where exchanges are recorded.
DATA_DIR=/data

# Recording filename (appended, rotated).
RECORD_FILE=records.jsonl

# --- Logging & recording ---
# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Format string for log lines (Python logging format syntax).
LOG_FORMAT=%(asctime)s %(name)s %(levelname)s %(message)s

# Master switch for JSONL exchange recording.
RECORDING_ENABLED=true

# --- Retries / backoff ---
# Maximum attempts per upstream request (1 = no retry).
RETRY_MAX_ATTEMPTS=3

# Initial backoff delay, in seconds (before the first retry).
RETRY_BACKOFF_INITIAL=0.5

# Exponential backoff base: delay = initial * base^(attempt-1).
RETRY_BACKOFF_BASE=2

# Upper bound on any single backoff delay, in seconds.
RETRY_BACKOFF_MAX=30

# Apply full jitter to the computed delay.
RETRY_BACKOFF_JITTER=true

# Comma-separated HTTP status codes that warrant a retry.
RETRYABLE_STATUS_CODES=408,429,500,502,503,504

# --- Loop detection ---
# Master switch for loop detection.
LOOP_DETECTION_ENABLED=true

# Sliding output window (bytes) over which repetition is measured; approximates an 8192-token window at ~4 bytes/token.
LOOP_WINDOW_BYTES=32768

# Fraction of the output window that must be produced before loop detection arms.
LOOP_MIN_OUTPUT_FRACTION=0.25

# Compression ratio below which the window is considered low-entropy (repetitive).
LOOP_COMPRESSION_RATIO=0.15

# HTTP status returned when a loop is detected and not remediated.
LOOP_ABORT_STATUS=502

# --- Loop remediation ---
# Master switch for re-submitting a looped request with varied sampling.
LOOP_RETRY_ENABLED=true

# Maximum number of loop re-submissions before giving up.
LOOP_RETRY_MAX_ATTEMPTS=5

# Amount added to a sampling parameter the client already submitted.
LOOP_RETRY_INCREMENT=0.1

# Fallback temperature when the client submitted none.
LOOP_RETRY_TEMPERATURE=1.2

# Fallback llama.cpp repeat penalty when the client submitted none.
LOOP_RETRY_REPEAT_PENALTY=1.2

# Fallback OpenAI presence penalty when the client submitted none.
LOOP_RETRY_PRESENCE_PENALTY=0.3

# Fallback OpenAI frequency penalty when the client submitted none.
LOOP_RETRY_FREQUENCY_PENALTY=0.3

# --- Stall detection ---
# Master switch for stall detection.
STALL_DETECTION_ENABLED=true

# Max seconds to wait for the first content-bearing token after headers.
STALL_TTFT_SECONDS=120

# Max seconds between content-bearing tokens once generation has started.
STALL_GAP_SECONDS=60

# HTTP status returned when a stall is detected.
STALL_ABORT_STATUS=502

# --- Context-window overflow ---
# Master switch for context-window overflow detection.
CONTEXT_WINDOW_DETECTION_ENABLED=true

# Comma-separated substrings (case-insensitive) signalling a full context window.
CONTEXT_WINDOW_MARKERS=exceeded the context window,context window exceeded,context length exceeded,maximum context length,prompt is too long,prompt is longer than the context,input is too long,ran out of context,exceeds the available context size

# HTTP status returned when an overflow is recognised but no upstream body is available to pass through.
CONTEXT_WINDOW_ABORT_STATUS=413

# --- Think-tag cleanup ---
# Master switch for think-tag cleanup.
THINK_CLEANUP_ENABLED=true

# Comma-separated tag names (case-insensitive) whose inner text is relocated into reasoning_content.
THINK_TAGS=think,thinking,reasoning

# Placeholder emitted as visible content when the model produced only a thinking tag.
THINK_EMPTY_RESPONSE_PLACEHOLDER=The model replied inside a thinking tag; see reasoning_content.

# --- Nudge (re-prompt empty turns) ---
# Master switch for re-prompting a turn that produced only reasoning.
THINK_NUDGE_ENABLED=true

# Nudge text appended as a user message on the re-submitted request.
THINK_NUDGE_TEXT=Your previous reply contained no visible text and no tool call. Reply with a visible answer, or call a tool if the task requires one.

# Max nudge re-submissions before falling back to the placeholder floor.
THINK_NUDGE_MAX_ATTEMPTS=2

# --- Coast detection ---
# Master switch for coast detection.
COAST_DETECTION_ENABLED=true

# Re-prompt text appended as a user message on the re-submitted request.
COAST_NUDGE_TEXT=You announced a tool call but did not make one. Call the tool now, or if the task is complete, say so explicitly.

# Max coast re-submissions before returning the coasted turn as-is.
COAST_MAX_ATTEMPTS=2

# --- Runaway-reasoning detection ---
# Master switch for runaway-reasoning detection.
RUNAWAY_REASONING_ENABLED=true

# Reasoning-token budget (~4 chars/token) above which a turn is flagged, provided no content has appeared.
RUNAWAY_REASONING_TOKEN_THRESHOLD=2000

# Re-prompt text appended as a user message on the re-submitted request.
RUNAWAY_REASONING_NUDGE_TEXT=Stop thinking and produce your final answer now, without further analysis. If the task requires a tool call, make it.

# Max runaway re-submissions before aborting the request.
RUNAWAY_REASONING_MAX_ATTEMPTS=2

# HTTP status returned when a runaway turn is detected and every re-submission also ran away.
RUNAWAY_REASONING_ABORT_STATUS=502

# --- Message overflow ---
# Master switch for message-overflow protection.
MESSAGE_OVERFLOW_ENABLED=true

# Size threshold, in characters, above which a tool-result message is treated as oversized.
MESSAGE_OVERFLOW_THRESHOLD=4096

# Truncate oversized tool results to a bounded prefix.
MESSAGE_OVERFLOW_TRUNCATE=true

# Warning text prepended to an oversized tool result.
MESSAGE_OVERFLOW_WARNING=This tool result is very large and may exceed the model's context window; the full result may have been truncated. Find a workaround rather than relying on the complete result.

# --- Tool-call syntax enforcement ---
# Master switch for tool-call validation/repair.
TOOL_CALL_GUARD_ENABLED=true
