# Upstream local LLM provider (OpenAI-compatible API).
LLM_BASE_URL=http://host.docker.internal:14434

# Gateway listen address/port.
HOST=0.0.0.0
PORT=9317

# Container runs as this UID/GID (compose `user:`). Match your host user so
# bind-mounted files (data/) are not root-owned. Defaults to 1000 when unset.
UID=1000
GID=1000

# Upstream read/write timeout, in seconds (generation can be slow).
REQUEST_TIMEOUT=300

# Upstream connection timeout, in seconds (fail fast on a dead endpoint).
CONNECT_TIMEOUT=10

# Where requests/responses are recorded.
DATA_DIR=/data
RECORD_FILE=records.jsonl

# --- Retries / backoff ---
# Maximum attempts per upstream request (1 = no retry).
RETRY_MAX_ATTEMPTS=8
# Initial backoff delay, in seconds (before the first retry).
RETRY_BACKOFF_INITIAL=1
# Exponential backoff base: delay = initial * base^(attempt-1).
RETRY_BACKOFF_BASE=2.0
# Upper bound on any single backoff delay, in seconds.
RETRY_BACKOFF_MAX=30
# Apply full jitter to the computed delay.
RETRY_BACKOFF_JITTER=true
# Comma-separated HTTP status codes that warrant a retry.
RETRYABLE_STATUS_CODES=408,429,500,502,503,504

# --- Loop detection ---
# Master switch for thinking/output loop detection.
LOOP_DETECTION_ENABLED=true
# Sliding window size (recent sentences compared against).
LOOP_WINDOW_SENTENCES=20
# Jaccard similarity threshold for "same sentence".
LOOP_JACCARD_THRESHOLD=0.65
# Number of similar sentences in the window that constitutes a loop.
LOOP_MIN_LOOP_COUNT=3
# Word n-gram size.
LOOP_NGRAM_SIZE=3
# Compression ratio below which the window is low-entropy.
LOOP_COMPRESSION_RATIO=0.22
# Minimum window length (chars) before the compression check applies.
LOOP_COMPRESSION_MIN_CHARS=300
# HTTP status returned when a loop is detected.
LOOP_ABORT_STATUS=502

# --- Stall detection (silently hung streams) ---
# Master switch for stalled-stream detection.
STALL_DETECTION_ENABLED=true
# Max seconds to wait for the FIRST content-bearing token after headers.
STALL_TTFT_SECONDS=120
# Max seconds between content-bearing tokens once generation has started.
# SSE keepalives do NOT reset this.
STALL_GAP_SECONDS=60
# HTTP status returned when a stall is detected.
STALL_ABORT_STATUS=502

# --- Context-window overflow ---
# Master switch: recognise the upstream's context-window-fill error and fail
# fast instead of retrying a request that can never succeed.
CONTEXT_WINDOW_DETECTION_ENABLED=true
# Comma-separated substrings (matched case-insensitively) that the upstream
# emits when the context window fills. Exact match — no fuzzy heuristics.
CONTEXT_WINDOW_MARKERS=exceeded the context window,context window exceeded,context length exceeded,maximum context length,prompt is too long,prompt is longer than the context,input is too long,ran out of context,exceeds the available context size
# HTTP status returned when a context-window overflow is recognised.
CONTEXT_WINDOW_ABORT_STATUS=413

# --- Think-tag cleanup ---
# Master switch: relocate leaked thinking tags out of visible content and
# guarantee a non-empty response.
THINK_CLEANUP_ENABLED=true
# Comma-separated tag names (case-insensitive) whose inner text is relocated
# out of `content` into `reasoning_content`. Exact tag names only.
THINK_TAGS=think,thinking,reasoning
# Placeholder emitted as visible content when the model produced only a
# thinking tag and nothing else.
THINK_EMPTY_RESPONSE_PLACEHOLDER=The model replied inside a thinking tag; see reasoning_content.

# --- Nudge (re-prompt empty-text turns) ---
# Master switch: re-submit a turn that produced only reasoning (finish_reason
# stop, no content, no tool calls) with a short re-prompt.
THINK_NUDGE_ENABLED=true
# Nudge text appended as a `user` message on the re-submitted request.
THINK_NUDGE_TEXT=Your previous reply contained no visible text and no tool call. Reply with a visible answer, or call a tool if the task requires one.
# Max nudge re-submissions before falling back to the placeholder floor.
THINK_NUDGE_MAX_ATTEMPTS=2

# --- Tool-call syntax enforcement ---
# Master switch: validate assembled tool calls, repair truncated
# function.arguments where deterministic, flag the rest without crashing.
TOOL_CALL_GUARD_ENABLED=true
